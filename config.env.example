# kagemusha configuration — copy this to `config.env` and edit.
# `config.env` is git-ignored (it holds paths, tokens and your notify topic).
# morning_brief.sh and inbound_watch.sh source this file.
# Override the location with LOOP_CONFIG=/path/to/config.env.

# ─── Where your work loop lives (created by scripts/setup.sh) ───────────────
PROJECT_ROOT="$HOME/work-loop"
SSOT_DIR="$PROJECT_ROOT/ssot"          # decisions.md / tasks.md / glossary.md / people.md
BRIEF_DIR="$PROJECT_ROOT/briefs"       # daily boards land here
LOG_DIR="$PROJECT_ROOT/logs"
QUEUE_FILE="$PROJECT_ROOT/approval_queue.md"

# ─── The agent CLI (headless / non-interactive) ────────────────────────────
# Default is the Claude CLI. To use a different CLI, edit AGENT_CMD/AGENT_MODEL/
# AGENT_FLAGS here AND see the "CLI-SWAP POINT" comment in scripts/morning_brief.sh
# (the invocation line differs per CLI).
AGENT_CMD="claude"
AGENT_MODEL="claude-opus-4-8"                 # model id your CLI expects ("" to omit --model)
AGENT_FLAGS="--dangerously-skip-permissions"  # headless/non-interactive flags for your CLI
# Driving MCP connectors headlessly (Tier-1 inbound sweep from a scheduler)?
# --dangerously-skip-permissions does not necessarily cover connector tools: a
# claude.ai connector was measured to fail with "permission not granted" until it
# was allow-listed explicitly. Add the tools you actually call, e.g.
#   AGENT_FLAGS="--dangerously-skip-permissions --allowedTools mcp__claude_ai_Gmail__search_threads,mcp__slack__slack_get_channel_history"
# Behavior differs per connector type — verify once by hand before going unattended
# (the check, and the false-negative trap in it, are in docs/inbound-loop.md).
AGENT_TIMEOUT=1500                            # seconds; hard cap on the run

# ─── Depth allocation — three tiers, one CLI ────────────────────────────────
# WHICH class of work goes in which tier is defined once, with zero model
# names, in templates/agent_instructions.md ("depth allocation" section,
# labeled beta there). This block is only the WIRING — which concrete model
# backs each tier on this machine — because that answer is per-machine,
# per-contract and goes stale in months; the judgment for wiring it doesn't.
#
# AGENT_MODEL above IS the default tier already — unchanged, still what every
# script uses out of the box. The two tiers below are additive and both
# optional:
AGENT_MODEL_FAST=""    # classify / extract / enumerate — a closed-enum answer
                        # and nothing else. INBW_CLASSIFY_MODEL (Inbound watch
                        # section, below) is this tier's existing special case
                        # for the inbound-watch classifier; unset it and it now
                        # falls back to this key, so set AGENT_MODEL_FAST once
                        # instead of per-script. "" = that call falls back to
                        # whatever the calling script already defaults to.
AGENT_MODEL_DEEP=""    # work you can't check against a source of truth you
                        # hold: pricing, contract terms, asserting an external
                        # fact, a call that can't be undone, strategy. ""
                        # (the default) = falls back to AGENT_MODEL above —
                        # leaving this unset never breaks anything.

# ─── Push notification (ntfy.sh) — a self-ping, so it stays "inward" ────────
# The brief writes a one-line summary to a local file; the script sends it to your
# phone via ntfy. Pick an unguessable topic (anyone who knows it can read your pings).
NTFY_TOPIC="change-me-to-something-unguessable"
NTFY_SERVER="https://ntfy.sh"
# NTFY_TOKEN="tk_xxxxxxxx"   # optional bearer token, only for access-protected topics
# Set to "0" to disable notifications entirely.
NTFY_ENABLED=1

# ─── Distillation courier (scripts/correction_scan.py + distill.sh) ─────────
# Harvest corrections daily for free; fire a model only when material has piled
# up. Design: docs/distillation-loop.md. All four paths below are YOUR data —
# keep them outside the kit's tracked files (the allowlist .gitignore already
# excludes them if they live in the clone).
DISTILL_MATERIAL_FILE="$PROJECT_ROOT/judgment/correction_material.md"  # append-only harvest
DISTILL_STATE_FILE="$PROJECT_ROOT/judgment/distill_state.json"         # pending counter
DISTILL_QUEUE_FILE="$PROJECT_ROOT/judgment/promotion_queue.md"         # candidates for YOUR review
# Your correction vocabulary. There is no built-in list — copy
# templates/correction_patterns.example.txt and cut it down to what you say.
DISTILL_PATTERNS_FILE="$PROJECT_ROOT/judgment/correction_patterns.txt"
DISTILL_THRESHOLD=5            # fire at this many un-distilled correction EVENTS
DISTILL_FALLBACK_DAYS=7        # …or after this many days, if at least 1 is pending
                               # (0 pending never fires: no material, no distillation)
# Named so the prompt can forbid writing it. The distiller proposes into the
# queue; promoting a candidate into this file is yours and stays manual.
DISTILL_RULES_FILE="$PROJECT_ROOT/CLAUDE.md"
# Optional: your existing principles, pasted in so candidates that contradict
# them are held in a separate section instead of quietly competing with them.
DISTILL_PRINCIPLES_FILE=""     # e.g. "$PROJECT_ROOT/judgment/judgment_model.md"
DISTILL_PROMPT_FILE=""         # "" = templates/distill-prompt.md in the kit
DISTILL_MAX_MATERIAL_LINES=400 # cap on how much material rides in one prompt

# ─── Inbound watch, Tier 2 (scripts/inbound_watch.sh.example) — optional ─────
# Tier 1 needs none of this: connect Gmail/Slack via your assistant's MCP
# connectors and run templates/inbound_sweep.md. This block is only for the
# unattended-scheduler fallback script. Empty value = that lane stays off.
# Docs + 5-minute per-channel setup walkthroughs: docs/inbound-loop.md.
INBW_QUIET_START="23:30"       # detection continues in quiet hours;
INBW_QUIET_END="06:30"         # pushes are held and merged into one morning roll-up
INBW_BASELINE_STORM=4          # first run of a lane with >= this many items = storm,
                               # suppressed as baseline (1-3 items pass as real input)
INBW_CLASSIFY=1                # 1 = classify new items via AGENT_CMD (closed enum);
                               # 0 = no LLM, everything lands on the morning board
# Model for that classification call specifically. Resolution order (see
# scripts/inbound_watch.sh.example): INBW_CLASSIFY_MODEL if set here, else
# AGENT_MODEL_FAST (above), else the script's own prior default. "" = use
# the fallback chain — you only need this if one script must pin a different
# model than AGENT_MODEL_FAST.
INBW_CLASSIFY_MODEL=""

# Hot contacts (10-min lane) — one "address|until|label" per line. Past the
# "until" date the 10-min watch stops by itself (demoted to the general sweep).
INBW_HOT_CONTACTS="
# alice@example.com|2026-12-31|client A (fast-reply culture)
"

# Gmail over IMAP — needs 2FA + an app password (NOT your account password);
# see docs/inbound-loop.md for the 5-minute setup. Reads with BODY.PEEK only —
# never marks anything read.
GMAIL_USER=""                  # you@gmail.com
GMAIL_APP_PASSWORD=""          # 16-char app password (plain secret — keep machine-local)
INBW_GMAIL_GENERAL=1           # 1 = hourly whole-inbox sweep (unknown-sender catcher)

# Slack — a bot token with channels:history, invited to the channels you watch.
SLACK_BOT_TOKEN=""             # xoxb-...
INBW_SLACK_CHANNELS=""         # space-separated channel IDs, e.g. "C0123ABCDEF"
INBW_SLACK_SELF_USER=""        # your own bot's user ID = not input, excluded

# RSS/Atom feeds (zero auth — the reference lane; works out of the box).
INBW_RSS_FEEDS="
# https://example.com/blog/feed.xml
"
