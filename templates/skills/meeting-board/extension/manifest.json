{
  "manifest_version": 3,
  "name": "会議ボード（Meet の字幕を読む）",
  "version": "0.1.0",
  "description": "Google Meet の字幕を話者つきで読み、この PC の中のヘルパー（127.0.0.1）にだけ渡します。音声は扱いません。",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["captions-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1:47431/*"],
  "action": {
    "default_title": "会議ボード"
  }
}
