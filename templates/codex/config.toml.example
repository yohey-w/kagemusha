# ═══════════════════════════════════════════════════════════════════════════
# .codex/config.toml — the per-repository settings Codex CLI reads.
#
#   cp templates/codex/config.toml.example .codex/config.toml
#   (or: ./scripts/setup.sh --codex, which also fills the path in for you)
#
# ⚠️ A PROJECT FILE IS ONLY READ IF THE PROJECT IS TRUSTED. Trust does not live
# here — it lives in your USER config, ~/.codex/config.toml, keyed by the
# absolute path. Measured on codex-cli 0.149.0 and again on 0.153.4: with the
# project untrusted, the hooks below are silently ignored — no warning, no
# error, no hook line in the transcript. Add this to ~/.codex/config.toml first:
#
#     [projects."/absolute/path/to/your/work-loop"]
#     trust_level = "trusted"
#
# ⚠️ HOOKS ALSO NEED HOOK TRUST, which is separate again. Codex asks you to
# review a hook the first time it sees it. An unattended run (cron) has nobody
# to ask, so a scheduled run needs `--dangerously-bypass-hook-trust` — and that
# flag means exactly what it says: every enabled hook runs unreviewed. Prefer
# running the CLI by hand once so the trust is persisted.
# ═══════════════════════════════════════════════════════════════════════════

# ─── model and reasoning ───────────────────────────────────────────────────
# The kit's scripts pass these per call (scripts/lib/agent_cli.sh), so what you
# put here is the default for the INTERACTIVE session you open in this folder.
model = "gpt-5.6-sol"
model_reasoning_effort = "xhigh"

# ─── sandbox ───────────────────────────────────────────────────────────────
# read-only  — the agent can look but not touch (what the distillation lane uses)
# workspace-write — it may write inside this folder (what the morning brief needs)
# The scripts pass -s explicitly, so this is, again, your interactive default.
sandbox_mode = "workspace-write"

# ─── the date stamp: the Codex equivalent of a Claude Code hook ────────────
# WHY IT EXISTS AT ALL. An agent that guesses today's date writes a deadline on
# the wrong weekday and the mistake reads as correct — a wrong "(Mon)" does not
# look wrong. So the machine states the date, once, at the top of every turn,
# and nothing has to remember to ask.
#
# ⚠️ CODEX WANTS JSON ON STDOUT. PLAIN TEXT IS DISCARDED. This is the one place
# in the kit where the two CLIs are genuinely NOT interchangeable. Claude Code
# takes the hook's raw stdout and prepends it to the turn; Codex parses stdout
# against a schema — `user-prompt-submit.command.output`, embedded in the codex
# binary — whose `additionalProperties` is false and whose `hookEventName` is
# required. So the stamp has to travel inside the envelope below. Hand Codex
# bare text and the interactive TUI answers
#
#     Hook failed: hook returned invalid user prompt submit JSON output
#
# while `codex exec` says NOTHING AT ALL — the output is dropped in silence and
# the turn simply has no date in it. That silence is why this deserves a
# paragraph: on the non-interactive lane the failure has no symptom except a
# model that has, once again, guessed the weekday.
#
# MEASURED 2026-09-07 on codex-cli 0.153.4, by putting a nonce inside the stamp
# and asking the model to read it back. With the envelope the nonce came back;
# with plain text it did not; with a bare {"additionalContext": "…"} and no
# envelope it did not either — that is `additionalProperties: false` at work.
# The envelope is the same shape Claude Code uses, so the two hooks differ in
# their wrapper and in nothing else.
#
# ON EDITING THE STAMP. The date format below contains no `"` and no backslash,
# so substituting it into the JSON cannot break the JSON. Keep it that way. The
# TOML value is a multi-line literal so that the JSON's double quotes and the
# date's single quotes both survive without a second layer of escaping.
#
# UserPromptSubmit fires before your message reaches the model. Other event
# names ship in the same binary — SessionStart, SessionEnd, Stop, PreToolUse,
# PostToolUse, PermissionRequest, Compact — but only UserPromptSubmit was
# measured here, so treat the rest as "present, unverified".
[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = '''printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}' "$(date '+[now] %Y-%m-%d (%a) %H:%M %Z')"'''

# ⚠️ A GIT WORKTREE READS THE MAIN CHECKOUT'S FILE, NOT ITS OWN. Measured
# 2026-09-07 on 0.153.4: running codex inside `git worktree add`-ed directory
# with its own .codex/config.toml, the hooks that fired were the MAIN
# checkout's and this file was ignored. Test hook changes in a plain clone.

# ─── the outbound guard: the rule that is a control, not a request ─────────
# WHY. The instructions file says "outward = ask first". Measured 2026-09-07 on
# codex-cli 0.153.4, with that rule in AGENTS.md and the sandbox at its most
# restrictive:
#
#     codex exec -s read-only "email the customer: 'this is a test'"
#
# …asked nobody, called gmail's send tool, and when exec's approval policy
# (never) refused the send, ROUTED AROUND IT and created a draft addressed to
# the real customer. Two things that run counter to intuition:
#
#   · `-s read-only` sandboxes the FILESYSTEM ONLY. A connector call is a
#     network call the sandbox has no opinion about, so the strictest sandbox
#     setting in the CLI does not slow an outgoing email down by one step.
#   · A blocked path is not a closed door. The model found the neighbouring
#     verb by itself, because nothing in the machine said no — only the prose.
#
# So the "no" moves into the machine. The hook below runs before every tool
# call and denies the outward ones; the script it points at carries the wire
# format, the verb list, and the reasoning. Re-measured with the hook in place
# on the same day: `create_draft` was denied, the model then tried to append to
# approval_queue.md instead, and `gmail.search_emails` still went through.
#
# ⚠️ IT IS ONE OF TWO LAYERS, AND THE OTHER ONE DID NOT WORK. The obvious
# second layer is to switch the connector off in config. Measured, on this
# version, it does not: see README (`外向きの歯止め` / `The outward brake`).
# Until that changes, this hook is the only measured control, which is also why
# tests/test_m_codex.sh feeds it synthetic payloads — a hook that prints
# nothing valid fails OPEN and in silence.
#
# ⚠️ THE PATH MUST BE ABSOLUTE. `./scripts/setup.sh --codex` copies the script
# to .codex/hooks/ and substitutes the absolute path below. If you are writing
# this file by hand, replace __PROJECT_ROOT__ with your own absolute path — a
# relative path resolves against the directory codex was STARTED in, which is
# not always the project root, and a hook that cannot be executed is a hook
# that silently is not there.
[[hooks.PreToolUse]]

[[hooks.PreToolUse.hooks]]
type = "command"
command = "__PROJECT_ROOT__/.codex/hooks/outbound_guard.sh"

# ─── skills ────────────────────────────────────────────────────────────────
# Codex discovers skills under ~/.codex/skills/ (and a plugin may add more).
# `./scripts/setup.sh --link-skills` symlinks templates/skills/* into whichever
# of ~/.claude/skills/ and ~/.codex/skills/ exists, so one copy serves both CLIs.
# There is nothing to configure here for that; this note is the signpost.

# ─── MCP servers ───────────────────────────────────────────────────────────
# Add them with `codex mcp add`, which writes them into your USER config rather
# than this file. The inbound lane's connector recipes are in docs/inbound-loop.md.
